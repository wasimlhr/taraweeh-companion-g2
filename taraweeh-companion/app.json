{
  "package_id": "com.taraweehcompanion.g2",
  "edition": "202601",
  "name": "Quran Companion",
  "version": "3.3.5",
  "min_app_version": "2.0.0",
  "min_sdk_version": "0.0.10",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Loads SDK assets and connects to backend transcription endpoints.",
      "whitelist": [
        "https://taraweeh-companion-g2-production-150e.up.railway.app",
        "wss://taraweeh-companion-g2-production-150e.up.railway.app/ws",
        "https://cdn.jsdelivr.net",
        "https://fonts.googleapis.com",
        "https://fonts.gstatic.com",
        "http://localhost:3001",
        "http://127.0.0.1:3001",
        "ws://localhost:3001",
        "ws://127.0.0.1:3001",
        "https://localhost:3443",
        "https://127.0.0.1:3443",
        "wss://localhost:3443",
        "wss://127.0.0.1:3443",
        "https://taraweeh.up.railway.app",
        "wss://taraweeh.up.railway.app/ws",
        "https://api.groq.com",
        "https://api.openai.com",
        "https://console.groq.com",
        "https://platform.openai.com"
      ]
    },
    {
      "name": "g2-microphone",
      "desc": "Captures live recitation from the G2 microphone."
    },
    {
      "name": "phone-microphone",
      "desc": "Uses phone microphone as fallback audio input."
    }
  ],
  "supported_languages": [
    "en"
  ]
}
