{
  "package_id": "com.taraweehcompanion.g2",
  "edition": "202601",
  "name": "Quran Translator",
  "version": "3.4.26",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.15",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Connects to our backend for transcription, translation packs and study content; optional provider setup and source-credit links.",
      "whitelist": [
        "https://taraweeh-companion-g2-production-150e.up.railway.app",
        "wss://taraweeh-companion-g2-production-150e.up.railway.app/ws",
        "http://localhost:3001",
        "http://127.0.0.1:3001",
        "ws://localhost:3001",
        "ws://127.0.0.1:3001",
        "https://localhost:3443",
        "https://127.0.0.1:3443",
        "wss://localhost:3443",
        "wss://127.0.0.1:3443",
        "https://taraweeh.up.railway.app",
        "wss://taraweeh.up.railway.app/ws",
        "https://console.groq.com",
        "https://platform.openai.com",
        "https://quranenc.com",
        "https://github.com",
        "https://tafsir.net",
        "https://creativecommons.org",
        "https://openfontlicense.org"
      ]
    },
    {
      "name": "g2-microphone",
      "desc": "Captures live recitation from the G2 microphone."
    },
    {
      "name": "phone-microphone",
      "desc": "Uses phone microphone as fallback audio input."
    }
  ],
  "supported_languages": [
    "en"
  ]
}
