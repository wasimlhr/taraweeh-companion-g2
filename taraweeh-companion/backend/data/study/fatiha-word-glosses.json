  "sources": [
    "https://corpus.quran.com/wordbyword.jsp?chapter=1&verse=1",
    "https://corpus.quran.com/wordbyword.jsp?chapter=1&verse=7"
  ],
  "verses": {
    "1:1": [
      "In (the) name",
      "(of) Allah,",
      "the Most Gracious,",
      "the Most Merciful."
    ],
    "1:2": [
      "All praises and thanks",
      "(be) to Allah,",
      "the Lord",
      "of the universe"
    ],
    "1:3": [
      "The Most Gracious,",
      "the Most Merciful."
    ],
    "1:4": [
      "(The) Master",
      "(of the) Day",
      "(of the) Judgment."
    ],
    "1:5": [
      "You Alone",
      "we worship,",
      "and You Alone",
      "we ask for help."
    ],
    "1:6": [
      "Guide us",
      "(to) the path,",
      "the straight."
    ],
    "1:7": [
      "(The) path",
      "(of) those",
      "You have bestowed (Your) Favors",
      "on them,",
      "not (of)",
      "those who earned (Your) wrath",
      "on themselves",
      "and not",
      "(of) those who go astray."
    ]
  }
}
