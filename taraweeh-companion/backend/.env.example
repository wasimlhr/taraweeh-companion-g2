# Shared transcription keys (sadaka jariya — free mode in the app UI).
# Groq and OpenAI are independent engines. Pick one; it must lock verses on its own.
# Get Groq: https://console.groq.com/keys
# Get OpenAI: https://platform.openai.com/api-keys
SHARED_GROQ_KEY=gsk_your_groq_key_here
SHARED_OPENAI_KEY=sk_your_openai_key_here

# Optional extra engines (selectable, not backups)
# SHARED_DEEPGRAM_KEY=your_deepgram_key_here
# SHARED_ELEVENLABS_KEY=your_elevenlabs_key_here

# Default engine: groq or openai
# TRANSCRIPTION_PROVIDER=groq

# Per-session cap for shared-key mode (minutes). BYOK users are uncapped.
MAX_MIN_PER_SESSION=90

# Optional: Gemini API key for non-Quran detection (tasbeeh, takbeer)
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional: mobile-only deployment mode (enforces phone mic in settings)
MOBILE_ONLY_MODE=false

# Server port (default: 3001)
PORT=3001

# Global WebSocket connection ceiling (deliberately not per-IP — mosque NAT /
# Railway proxy would make every user share one address). Default: 200
# WS_MAX_CONNECTIONS=200
