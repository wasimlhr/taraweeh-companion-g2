{
  "name": "taraweeh-companion",
  "version": "3.1.0",
  "description": "Taraweeh Companion — real-time Quran recitation on Even G2 smart glasses",
  "type": "module",
  "scripts": {
    "postinstall": "cd backend && npm install",
    "start": "cd backend && npm run start",
    "backend:dev": "cd backend && npm run dev",
    "qr": "npx @evenrealities/evenhub-cli@0.1.14 qr --http --port 3001",
    "qr:url": "npx @evenrealities/evenhub-cli@0.1.14 qr --url",
    "qr:railway": "node scripts/qr-web-url.js https://taraweeh.up.railway.app --png",
    "kill-backend": "node scripts/kill-port-3001.js",
    "evenhub:download": "node scripts/download-evenhub-tools.js",
    "sim": "node scripts/run-evenhub-simulator.js http://localhost:3001",
    "replay:youtube": "node scripts/replay-youtube-recitation.js",
    "simulator": "npm run sim",
    "live-monitor": "powershell -ExecutionPolicy Bypass -File scripts/live-monitor.ps1",
    "download-quran-db": "node scripts/download-quran-db.js",
    "build:evenhub": "node scripts/build-evenhub-dist.js",
    "pack:evenhub": "node scripts/pack-evenhub.js",
    "pack:evenhub:check": "node scripts/pack-evenhub.js --check",
    "test": "node --test backend/transcriptionRouter.test.js",
    "test:version": "node scripts/check-version-alignment.js",
    "test:provider-key": "node scripts/check-provider-key.js"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "dotenv": "^17.3.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.0"
  }
}
